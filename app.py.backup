"""Networking Quiz Score API - a small Flask API with a quiz web page.

A user takes a short networking quiz. The API checks the answers, calculates
the score, saves it, and returns JSON like {"user": "Anna", "score": 80}.

Run locally:  flask --app app run --port 5001
"""
import json
import threading
from datetime import datetime
from pathlib import Path

from flask import Flask, jsonify, request, send_from_directory

app = Flask(__name__)

BASE_DIR = Path(__file__).parent
SCORES_FILE = BASE_DIR / "scores.json"
_lock = threading.Lock()

# "answer" is the index of the correct option. It is never sent to the client.
QUESTIONS = [
    {"id": 1, "question": "How many usable host addresses are there in a /24 network?",
     "options": ["256", "254", "255", "252"], "answer": 1},
    {"id": 2, "question": "What is the subnet mask for /26?",
     "options": ["255.255.255.0", "255.255.255.128", "255.255.255.192", "255.255.255.224"], "answer": 2},
    {"id": 3, "question": "What is the network address of 192.168.10.77/26?",
     "options": ["192.168.10.0", "192.168.10.64", "192.168.10.77", "192.168.10.128"], "answer": 1},
    {"id": 4, "question": "What does a VLAN do?",
     "options": ["Encrypts all traffic on a switch",
                 "Splits a switch into separate logical networks (broadcast domains)",
                 "Increases the cable length",
                 "Assigns IP addresses automatically"], "answer": 1},
    {"id": 5, "question": "Which standard is used for VLAN tagging on a trunk link?",
     "options": ["IEEE 802.11", "IEEE 802.3", "IEEE 802.1Q", "IEEE 802.1X"], "answer": 2},
    {"id": 6, "question": "Which Cisco command shows a short list of interfaces with their IP addresses and status?",
     "options": ["show running-config", "show ip interface brief", "show vlan", "show version"], "answer": 1},
    {"id": 7, "question": "Which of these is a private IP address?",
     "options": ["8.8.8.8", "11.0.0.1", "172.16.5.10", "200.10.10.1"], "answer": 2},
    {"id": 8, "question": "At which OSI layer does a router mainly work?",
     "options": ["Layer 1 (Physical)", "Layer 2 (Data link)", "Layer 3 (Network)", "Layer 4 (Transport)"], "answer": 2},
    {"id": 9, "question": "Which protocol does the ping command use?",
     "options": ["ICMP", "HTTP", "DHCP", "SSH"], "answer": 0},
    {"id": 10, "question": "What does the default gateway do for a host?",
     "options": ["Gives the host a way to reach other networks",
                 "Translates domain names to IP addresses",
                 "Assigns the host an IP address",
                 "Blocks all incoming traffic"], "answer": 0},
]


def load_scores():
    if not SCORES_FILE.exists():
        return []
    try:
        return json.loads(SCORES_FILE.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return []


def save_scores(scores):
    tmp = SCORES_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(scores, indent=2, ensure_ascii=False), encoding="utf-8")
    tmp.replace(SCORES_FILE)


def calculate_score(answers):
    """Compare the user's answers with the correct answers.

    Returns (correct_count, total, percent). Missing answers count as wrong.
    """
    correct = 0
    for q in QUESTIONS:
        if answers.get(str(q["id"])) == q["answer"]:
            correct += 1
    total = len(QUESTIONS)
    return correct, total, round(correct / total * 100)


@app.get("/")
def home():
    return send_from_directory(BASE_DIR / "static", "index.html")


@app.get("/api")
def api_info():
    return jsonify(
        name="Networking Quiz Score API",
        endpoints=["GET /api/health", "GET /api/questions",
                   "POST /api/submit", "GET /api/scores"],
    )


@app.get("/api/health")
def health():
    return jsonify(status="ok", questions=len(QUESTIONS))


@app.get("/api/questions")
def questions():
    public = [{"id": q["id"], "question": q["question"], "options": q["options"]}
              for q in QUESTIONS]
    return jsonify(count=len(public), questions=public)


@app.post("/api/submit")
def submit():
    data = request.get_json(silent=True)
    if not isinstance(data, dict):
        return jsonify(error="Send JSON like {\"user\": \"Anna\", \"answers\": {\"1\": 1}}"), 400
    user = str(data.get("user", "")).strip()
    answers = data.get("answers")
    if not user or len(user) > 30:
        return jsonify(error="'user' is required (max 30 characters)"), 400
    if not isinstance(answers, dict):
        return jsonify(error="'answers' must be an object like {\"1\": 1, \"2\": 0}"), 400

    correct, total, score = calculate_score(answers)
    with _lock:
        scores = load_scores()
        scores.append({"user": user, "score": score, "correct": correct,
                       "total": total, "time": datetime.now().isoformat(timespec="seconds")})
        save_scores(scores)
    return jsonify(user=user, score=score, correct=correct, total=total)


@app.get("/api/scores")
def scores():
    ranked = sorted(load_scores(), key=lambda s: (-s["score"], s["time"]))[:10]
    return jsonify(count=len(ranked), scores=ranked)


@app.errorhandler(404)
def not_found(_):
    return jsonify(error="Not found"), 404


@app.errorhandler(405)
def not_allowed(_):
    return jsonify(error="Method not allowed"), 405


if __name__ == "__main__":
    app.run(host="127.0.0.1", port=5001, debug=True)
